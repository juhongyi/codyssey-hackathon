# cp .env.example .env 후 실제 값을 입력하세요. 키는 Git에 커밋하지 않습니다.
COPA_API_KEY=
COPA_CHAT_URL=https://copa.codyssey.kr/v1/chat/completions
COPA_CHAT_MODEL=claude-opus-4-8
COPA_MAX_TOKENS=16384
COPA_TTS_URL=https://copa.codyssey.kr/api/v1/audio/tts
COPA_TTS_MODEL=tts-1
COPA_TTS_VOICE=alloy

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_STT_MODEL=@cf/openai/whisper-large-v3-turbo

ODYSSEY_OUTPUT_DIR=outputs
# 인터뷰 질문 상한: 1 이상의 정수. 충분한 정보 또는 사용자 요청 시 조기 종료합니다.
ODYSSEY_MAX_QUESTIONS=10
# 16 kHz mono 녹음: 환경에 따라 발화 감지 RMS 임계값을 조정하세요.
ODYSSEY_SPEECH_THRESHOLD=0.015
ODYSSEY_END_SILENCE_SECONDS=1.8
ODYSSEY_START_TIMEOUT_SECONDS=120
ODYSSEY_MAX_TURN_SECONDS=120
