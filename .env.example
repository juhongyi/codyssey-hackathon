# Copy to .env and supply credentials locally. Never commit .env.
CODYSSEY_BASE_URL=https://copa.codyssey.kr
CODYSSEY_API_KEY=
INTERVIEW_MODEL=claude-haiku-4
PLANNING_MODEL=claude-haiku-4
TTS_MODEL=tts-1
TTS_VOICE=alloy

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
STT_MODEL=@cf/openai/whisper-large-v3-turbo

# Maximum user turns, including the initial unprompted recording.
MAX_QUESTIONS=12
API_TIMEOUT_SECONDS=120
OUTPUT_DIR=outputs
