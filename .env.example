POSTGRES_USER=odyssey
POSTGRES_PASSWORD=odyssey
POSTGRES_DB=odyssey

# Codyssey gateway (LLM and TTS). Never expose keys to the frontend.
CODYSSEY_API_BASE_URL=https://copa.codyssey.kr
CODYSSEY_API_KEY=
INTERVIEWER_LLM_MODEL=claude-haiku-4
PLANNER_LLM_MODEL=gpt-5.5
CODYSSEY_TTS_MODEL=gpt-4o-mini-tts
CODYSSEY_TTS_VOICE=alloy

# STT uses Cloudflare Workers AI only.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
WORKERS_AI_STT_MODEL=@cf/openai/whisper-large-v3-turbo

# Maximum questions; AI may finish earlier. Minimum accepted value: 1.
INTERVIEW_MAX_QUESTIONS=10
# Original audio is bind-mounted from ./storage/audio on the backend host.
